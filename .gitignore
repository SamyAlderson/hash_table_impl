# .gitignore

# ignore node_modules folder
node_modules/

# ignore .env file
.env

# ignore build folder
build/

# ignore coverage folder
coverage/

# ignore IDE files
.idea/
.vscode/

# ignore other IDE files
*.iml
*.pyc
*.class

# ignore logs
logs/

# ignore cache
.cache/

# ignore other stuff
*.log
*.tmp
*.bak
*.swp

# ignore IDE config files
*.sublime-project
*.sublime-workspace
*.vscode/settings.json
*.vscode/launch.json

# ignore other IDE config files
*.idea/workspace.xml
*.idea/.gitignore
*.idea/.vscode/